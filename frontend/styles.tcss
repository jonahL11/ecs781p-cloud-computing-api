/*
 * styles.tcss - Textual CSS for the frontend.
 *
 * Works like web CSS, but sizes are in terminal cells (1 = one character
 * wide, or one line tall). Colours such as $primary, $accent and $error come
 * from the active theme (set in app.py), so the whole app re-colours itself
 * if you pick another theme with Ctrl+P -> "Change theme".
 *
 * Tip: run `textual run --dev app.py` and edits here appear instantly.
 */

/* ---------- Page ---------------------------------------------------------- */

Screen {
    background: $background;
}

/* Login / signup: centre the card. Screens scroll if the terminal is short. */
FormScreen {
    align: center middle;
}

/* ---------- Card ---------------------------------------------------------- */

#card {
    width: 62;
    max-width: 100%;
    height: auto;
    padding: 1 4;
    background: $surface;
    border: round $primary 60%;
    border-title-align: center;
    border-title-color: $accent;
    border-title-style: bold;
}

#brand {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $primary;
}

#tagline {
    width: 100%;
    text-align: center;
    color: $text-muted;
    text-style: italic;
}

/* ---------- Log in | Sign up switcher ------------------------------------- */

#tabs {
    width: 100%;
    height: 1;
    align: center middle;
    margin: 1 0;
}

/* Turn the tab buttons into plain text links. */
Button.tab {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 2;
    border: none;
    background: transparent;
    color: $text-muted;
    text-style: none;
}

Button.tab:hover,
Button.tab:focus {
    background: transparent;
    color: $text;
    text-style: underline;
}

Button.tab.current {
    color: $accent;
    text-style: bold underline;
}

.tab-divider {
    width: auto;
    color: $text-muted;
}

/* ---------- Fields -------------------------------------------------------- */

.field-label {
    color: $text;
    text-style: bold;
    padding-left: 1;
}

/* Password label + strength meter on one line. */
.label-row {
    height: 1;
}

.label-row .field-label {
    width: 1fr;
}

Input {
    width: 100%;
    border: tall $panel-lighten-2;
    background: $boost;
}

Input:focus {
    border: tall $accent;
}

/* Textual adds -invalid / -valid after validation runs. */
Input.-invalid {
    border: tall $error 60%;
}

Input.-invalid:focus {
    border: tall $error;
}

/* Error line under each field; hidden until there's something to say. */
.field-error {
    display: none;
    height: auto;
    color: $error;
    padding-left: 1;
}

/* ---------- Password strength meter --------------------------------------- */

#strength {
    width: auto;
    padding-right: 1;
}

#strength.s0 { color: $error; }
#strength.s1 { color: $error; }
#strength.s2 { color: $warning; }
#strength.s3 { color: $success 70%; }
#strength.s4 { color: $success; }

/* ---------- Show password checkbox ---------------------------------------- */

#show-password {
    height: 1;
    margin-top: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $text-muted;
}

#show-password:focus {
    border: none;
    background: transparent;
    color: $text;
}

/* ---------- Banner message (server errors etc.) --------------------------- */

#message {
    display: none;
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
}

#message.error {
    color: $error;
    background: $error 15%;
    border-left: wide $error;
}

#message.success {
    color: $success;
    background: $success 15%;
    border-left: wide $success;
}

#message.info {
    color: $text;
    background: $primary 15%;
    border-left: wide $primary;
}

/* ---------- Main button --------------------------------------------------- */

#submit {
    width: 100%;
    margin-top: 1;
}


/* ========================================================================= */
/*  Logged-in pages: sidebar + content (navigation.py, favourites_page.py)   */
/* ========================================================================= */

#layout {
    height: 1fr;
}

/* ---------- Sidebar ------------------------------------------------------- */

#sidebar {
    width: 26;
    height: 100%;
    padding: 1 1;
    background: $panel;
    border-right: vkey $primary 40%;
}

#sidebar-brand {
    width: 100%;
    text-style: bold;
    color: $primary;
    padding: 0 1;
    margin-bottom: 1;
}

/* Sidebar items look like menu rows, not chunky buttons. */
Button.nav {
    width: 100%;
    min-width: 0;
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
    border: none;
    background: transparent;
    color: $text-muted;
    text-align: left;
    content-align: left middle;
    text-style: none;
}

Button.nav:hover,
Button.nav:focus {
    background: $boost;
    color: $text;
}

Button.nav.current {
    background: $primary 25%;
    color: $text;
    text-style: bold;
}

#sidebar-spacer {
    height: 1fr;
}

#nav-logout {
    color: $error;
}

#nav-logout:hover,
#nav-logout:focus {
    background: $error 20%;
}

/* ---------- Page content -------------------------------------------------- */

#content {
    width: 1fr;
    height: 100%;
    padding: 1 3;
}

#page-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#result-count {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

/* ---------- Paper cards --------------------------------------------------- */

.paper-list {
    height: 1fr;
}

.paper {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface;
    border-left: wide $primary 50%;
}

.paper:hover {
    background: $boost;
}

.paper-info {
    width: 1fr;
    height: auto;
}

.paper-title {
    text-style: bold;
    color: $text;
}

.paper-meta {
    color: $text-muted;
}

.paper-cites {
    color: $accent;
}

/* Favourite toggle: a bordered button with a star and a word, so it is
   easy to see and click (terminals can't make one character bigger). */
Button.fav-toggle {
    width: 13;
    min-width: 13;
    height: 3;
    margin-left: 1;
    border: round $panel-lighten-2;
    background: transparent;
    color: $text-muted;
    text-style: bold;
    content-align: center middle;
}

Button.fav-toggle:hover,
Button.fav-toggle:focus {
    background: $warning 15%;
    border: round $warning;
    color: $warning;
}

Button.fav-toggle.saved {
    border: round $warning;
    background: $warning 20%;
    color: $warning;
}

Button.remove {
    width: auto;
    min-width: 0;
    margin-left: 1;
}

/* ---------- Empty states -------------------------------------------------- */

.empty-state {
    height: auto;
    padding: 2 2;
    color: $text-muted;
    text-align: center;
    border: dashed $panel-lighten-2;
}

#empty-title {
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

.hint {
    margin-top: 1;
    color: $text-muted;
    text-style: italic;
}

.hint {
    margin-bottom: 1;
}

/* Generic "nothing here" box. */
.placeholder {
    height: auto;
    padding: 2 2;
    color: $text-muted;
    text-style: italic;
    border: dashed $panel-lighten-2;
    text-align: center;
}

.welcome {
    text-style: bold;
    margin-bottom: 1;
}

.section-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

/* ---------- My Profile ---------------------------------------------------- */

#profile {
    height: 1fr;
}

#profile-header {
    height: 5;
    margin-bottom: 1;
}

#avatar {
    width: 11;
    height: 5;
    content-align: center middle;
    text-style: bold;
    color: $background;
    background: $accent;
    border: round $accent;
}

#profile-name-block {
    width: 1fr;
    height: 5;
    padding: 1 2;
}

#profile-name {
    text-style: bold;
    color: $text;
}

#profile-email {
    color: $text-muted;
}

.profile-section {
    width: 70;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    background: $surface;
    border: round $primary 40%;
}

.profile-row {
    height: 1;
}

.profile-label {
    width: 16;
    color: $text-muted;
}

.profile-value {
    width: 1fr;
    text-style: bold;
}

#recent-saved {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#edit-row {
    height: auto;
}

#new-username {
    width: 1fr;
}

#save-username {
    margin-left: 1;
}
